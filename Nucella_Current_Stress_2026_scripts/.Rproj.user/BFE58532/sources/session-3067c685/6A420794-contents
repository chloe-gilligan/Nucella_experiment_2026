```{r rename-columns}
# Keep only the columns we actually need: the ID columns (by position,
# since they're always the first 4 columns) plus length/width/shell
# thickness (matched by name, so it doesn't matter exactly how the
# messy weight/time columns get named by clean_names()).

data <- raw %>%
  rename(
    rep          = 1,   # sample ID, e.g. "YY6"
    snail_number = 2,   # 1, 2, or 3 within the rep
    tag_number   = 3,
    tag_color    = 4
  ) %>%
  rename_with(~"length_mm", contains("length")) %>%
  rename_with(~"width_mm", contains("width")) %>%
  rename_with(~"shell_thickness", contains("shell")) %>%
  rename_with(~"notes", contains("note")) %>%
  select(rep, snail_number, tag_number, tag_color,
         length_mm, width_mm, shell_thickness, notes)

head(data)
```


